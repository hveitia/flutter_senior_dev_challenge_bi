#!/usr/bin/env bash
# Keeps main releasable: a commit is only created when the workspace is green.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# The verification reads the working tree, so it only says something about the
# commit when the working tree holds exactly what is being committed. A change
# left unstaged, or a new file left untracked, would be verified without being
# part of the commit, and a commit that does not build could get through.
guarded=(apps packages contracts firebase tool)

unstaged=$(git diff --name-only -- "${guarded[@]}")
untracked=$(git ls-files --others --exclude-standard -- "${guarded[@]}")

if [ -n "$unstaged" ] || [ -n "$untracked" ]; then
  {
    echo "pre-commit: the working tree differs from what is being committed."
    echo "Stage or stash these files so the verification covers the commit:"
    [ -z "$unstaged" ] || printf '  not staged: %s\n' $unstaged
    [ -z "$untracked" ] || printf '  untracked:  %s\n' $untracked
  } >&2
  exit 1
fi

# The staged list is read here, while git's own view of the commit is intact,
# and handed over: the variables cleared below are what tell git which index
# this commit uses.
VERIFY_STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)
export VERIFY_STAGED

# Git exports these to its hooks. In a linked worktree they point at the main
# repository, and every tool that asks git where it is gets that answer: the
# Flutter tool then takes this repository for its own SDK checkout and stops
# resolving dependencies. Without them, each tool finds the repository from
# the directory it runs in.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Format and analysis cover the whole repository; tests run for what the
# commit can break. CI runs everything on every push.
exec tool/verify.sh --affected

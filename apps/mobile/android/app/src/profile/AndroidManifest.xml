<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Development builds may reach the developer's own machine over plain
         HTTP, and only there: the customer API and the partner pages served
         locally. Release builds have no such exception: they keep Android's
         default, HTTPS only. See res/xml/network_security_config.xml. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>

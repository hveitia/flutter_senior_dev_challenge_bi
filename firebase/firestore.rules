rules_version = '2';

// Deny by default: anything not matched below is rejected.
// Balances, accounts and movements are never written from a client. They are
// changed only by the server API through the Admin SDK, which bypasses rules.
// The only thing a client writes is the customer's own profile.
// Tests: firebase/test/firestore.rules.test.js
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Every field a profile has. Nothing else may be stored in it, so a
    // client cannot give itself a balance or a role.
    function profileFields() {
      return ['fullName', 'nationalId', 'email', 'phone', 'segment',
              'interests', 'createdAt'];
    }

    function isValidProfile(profile) {
      return profile.keys().hasOnly(profileFields())
          && profile.keys().hasAll(profileFields())
          && profile.fullName is string
          && profile.fullName.size() >= 3
          && profile.fullName.size() <= 120
          && profile.nationalId is string
          && profile.nationalId.matches('^[0-9]{10}$')
          // The profile belongs to the account that is signed in.
          && profile.email is string
          && profile.email == request.auth.token.email
          && profile.phone is string
          && profile.phone.matches('^09[0-9]{8}$')
          // Segment ids are the keys of the published home configuration.
          && profile.segment in ['starting', 'family', 'wealth']
          && profile.interests is list
          && profile.interests.size() <= 7
          && profile.interests.hasOnly(['saving', 'investing', 'travel',
              'billPayments', 'credit', 'insurance', 'business'])
          // Each interest once: the size limit alone lets one be repeated.
          && profile.interests.toSet().size() == profile.interests.size()
          && profile.createdAt is timestamp;
    }

    // Every field of a transfer order as the app leaves it. The limits are the
    // server's (apps/backoffice/lib/api/transfer.ts); they change together.
    // The server checks all of this again and the balances as well: this
    // only keeps a client from storing anything that is not an order.
    function transferFields() {
      return ['fromAccountId', 'toAccountId', 'amountCents', 'concept',
              'status', 'createdAt'];
    }

    function isAccountId(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    function isPendingTransfer(transfer) {
      return transfer.keys().hasOnly(transferFields())
          && transfer.keys().hasAll(transferFields())
          && isAccountId(transfer.fromAccountId)
          && isAccountId(transfer.toAccountId)
          && transfer.fromAccountId != transfer.toAccountId
          // Whole cents: `is int` rejects 10.5 and numbers sent as text.
          && transfer.amountCents is int
          && transfer.amountCents > 0
          && transfer.amountCents <= 500000
          && transfer.concept is string
          && transfer.concept.size() <= 80
          // A client can only ask; settling is the server's.
          && transfer.status == 'pending'
          // The creation time is the server's, never the device's.
          && transfer.createdAt == request.time;
    }

    // Published experience configuration (home modules, flags, resilience).
    // Any signed-in customer reads it, so it must never hold sensitive data.
    match /config/{document} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // The creation time is the server's, never the device's.
      allow create: if isOwner(uid)
          && isValidProfile(request.resource.data)
          && request.resource.data.createdAt == request.time;

      // What identifies the customer cannot be edited afterwards.
      allow update: if isOwner(uid)
          && isValidProfile(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.nationalId == resource.data.nationalId
          && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // A transfer order waiting to be carried out. The app may only leave
      // it: the server settles it and nobody edits or removes it afterwards.
      // The document id is the idempotency key, chosen by the app.
      match /transfers/{transferId} {
        allow create: if isOwner(uid)
            && transferId.matches('^[A-Za-z0-9_-]{16,64}$')
            && isPendingTransfer(request.resource.data);
        allow update, delete: if false;
      }

      // Accounts, movements and anything else under the customer: read-only.
      match /{document=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }
  }
}
